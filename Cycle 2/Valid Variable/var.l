%{
#include "y.tab.h" // Include tokens generated by Yacc
%}

%%

[a-zA-Z]    { return LETTER; } /* If a letter is found, send LETTER token to Yacc */
[0-9]       { return DIGIT; }  /* If a digit is found, send DIGIT token to Yacc */
\n          { return '\n'; }   /* Send newline to trigger evaluation */
.           { return yytext[0]; } /* Send any other character (like @, #) as itself */

%%

int yywrap(void) {
    return 1;
}